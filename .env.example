# Copy this file to .env and replace the Gmail values. Never commit .env.
RESOURCEHUB_SMTP_HOST=smtp.gmail.com
RESOURCEHUB_SMTP_PORT=587
RESOURCEHUB_SMTP_FROM=your-sender@gmail.com
RESOURCEHUB_SMTP_USERNAME=your-sender@gmail.com
RESOURCEHUB_SMTP_PASSWORD=your-google-app-password
# Localhost uses Cloudflare's published test keys automatically.
# For a public site, uncomment and replace both with keys from your widget:
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
