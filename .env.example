# Example configuration only. Never put real credentials in this file.
# Copy to a private .env file and replace these placeholders.
# Flask page roles. Uncomment and replace both username/password pairs you need.
# Keep real values only in .env; never commit that file.
# RESOURCEHUB_SECRET_KEY=replace-with-a-long-random-secret
# RESOURCEHUB_ADMIN_USERNAME=owner
# RESOURCEHUB_ADMIN_PASSWORD=replace-with-a-long-random-password
# RESOURCEHUB_STAFF_USERNAME=staff
# RESOURCEHUB_STAFF_PASSWORD=replace-with-a-long-random-password

RESOURCEHUB_SMTP_HOST=smtp.gmail.com
RESOURCEHUB_SMTP_PORT=587
RESOURCEHUB_SMTP_FROM=your-email@example.com
RESOURCEHUB_SMTP_USERNAME=your-email@example.com
RESOURCEHUB_SMTP_PASSWORD=your-app-password

# Local development may use the published test keys.
# For a public deployment, configure your own Turnstile keys.
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
